ucdHomeV2:{coachmark:{tabs:[{heading:'Overview tab',desc:'Get all updates about leads & earnings here'},{heading:'Leads tab',desc:'See all the leads your have ever shared and their statuses here'},{heading:'Earnings tab',desc:'Get an update about commission  and payout credited to you'}],yourPerformance:{heading:'Track your performance',desc:'Get an overview of your earnings, Leads shared, inspections & stock ins'},yourActivity:{heading:'Track your activity',desc:'Check out the latest updates about your leads'},shareCta:{heading:'Share a lead',desc:'You can share a new lead by clicking here'}}},formStrength:{leadStrength:'Lead strength',title:'increase lead strength to increase chances of conversion:',addPhoneNo:'1. Add phone number',addRegNo:'2. Add reg number',addOwnerNo:"3. Add owner's name"},loaderComponent:{title:'Checking details',message:'Please wait while we crosscheck the details that you have entered.'},leaddForm:{topSection:{heading:'Select lead type',seller:{title:'Seller Lead',selected:!1,heighlights:{heading:'Commission range',point1:'3% commission on cars under \u20b93,00,000',point2:'2% commission on cars over \u20b93,00,000'},description:'Refer customer cars here and earn commission basis RC payment'},inventory:{title:'Inventory Lead',selected:!1,heighlights:{heading:'Not eligible for commission',point:'No commissions are paid in case of third party transactions.'},description:'List your own inventory here and get\nThird Party Payment, no extra commission'}},successPopUpData:{title:'Lead Accepted',message:'Yay! Your submitted lead has been successfully accepted. \ud83c\udf89',bottomCTA:'Back to leads',bookAppointmentCTA:'Book appointment',howToInsure:{title:'How to Book an Appointment',data:[{title:'Book from the Cars24 Channel Partners App',message:[{isHighlighted:!1,text:'Remind customer to book inspection using the SMS link for quick conversion. Once inspection is booked status will change to '},{isHighlighted:!0,text:'INSPECTION PENDING'}]},{title:'Customer can Book with the link sent on SMS',message:[{isHighlighted:!1,text:'Copy & share the inspection booking link with the customer from the lead details page'}]}],remark:'If lead status is Duplicate, then no SMS will be sent to customer. Cars24 already has this lead.'}},successPopUpInventoryData:{title:'Lead Accepted',message:'Yay! Your submitted lead has been successfully accepted. \ud83c\udf89',bottomCTA:'Back to leads',bookAppointmentCTA:'Book an appointment',howToInsure:{title:'Next steps for you:',data:[{title:'Ensure you book appointment',message:[{isHighlighted:!1,text:'Book appointment for inspection on accepted leads. Once appointment is booked status will change to '},{isHighlighted:!0,text:'INSPECTION PENDING'}]}],remark:'If lead status is Duplicate, then appointment can not be booked. Cars24 already has this lead.'}},duplicatePopUpData:{title:'Lead already exists',message:'This lead was submitted by another dealer.',cta1:'Submit another lead',cta2:'Back to leads'},formData:{mobileNo:{label:"Car owner's phone number ",isMandatory:!0,prefix:'+ 91 - ',placeHolder:'Enter phone number',error:'Enter Valid Phone No',key:'mobile_no',submitValue:''},regNo:{label:'Car registration no ',isMandatory:!1,placeHolder:'Enter registration no',key:'reg_no',error:'Enter Valid Reg No',submitValue:''},name:{label:"Car owner's name ",isMandatory:!1,placeHolder:"Enter car owner's name",key:'owner_name',error:'Enter Valid Name',submitValue:''},submit:'SUBMIT',checkBoxText:'I have understood the commission rules mentioned above & save this selection for later.',checkBoxUncheckedToast:'Please agree to the commission rules mentioned above'},faqData:{title:'Policy FAQ\u2019s',description:"1. Tip to earn more: More inspections = More earnings! Book inspection in just a few clicks.\n\n2. We accept all types of cars.\n\n3. Already inspected / appointment booked leads will be considered as duplicate & will not be accepted.\n\n4. Phone number, car owner's name and Registration number of seller is defined as lead.\n\n5. Process: Once channel partner submits lead on the App, customer will receive a link on SMS to fill details and book inspection. As a channel partner you can also book on appointment on the App.\n\n6. Track progress of the lead from appointment booking to inspection completion to stockin from the App.\n\n7. Booking appointment via the website or any other link will not be considered as an appointment.\n\n8. Most dealers also sell 1 car every 8 inspections. Better the car, more the chances of stockin.\n\n9. Commission calculation: If Cars24 quote is less than 3 lakhs then commission = 3% of C24Q and if Cars24 quote is greater than 3 lakhs then commission = 2%.\n\n10. Commission is only paid for seller leads. No Commission will be paid to partner if car payment is not done in customer's account.\n\n11. Commission payout will be credited instantly post stock-in into your Cars24 registered bank account."},commissionSection:{commissionTerms:'COMMISSION TERMS',commissionRange:'Commission range',commissionCard:{cardHeading:'Commission not eligible in case of ',cardItem:[{heading:'Third Party Payment',subHeading:'Commission is paid only in case of RC payments'},{heading:'Booking using incorrect link',subHeading:'Book appt from the app or using correct One Time Link'},{heading:'Reg no. mismatch',subHeading:'Lead reg no. should match inspection reg no.'}],learnMore:'Learn More'},commissionModal:{cards:[{header:"Third Party\nPayment",footer:"Commission Not Eligible"},{header:"Book Appointment from\nApp / One Time Link",footer:"Commission Eligible"},{header:"Registration number\nmismatch",footer:"Commission Not Eligible"}],cta:{next:'NEXT',gotIt:'GOT IT!'}}}},myLeads:{myLeads:'My leads',viewDetails:'VIEW DETAILS',filter:{leadStatus:{heading:'',filters:[{status:'',text:'All'},{status:'APPOINTMENT_PENDING',text:'Inspection not booked'},{status:'INSPECTION_PENDING',text:'Upcoming Appointments'},{status:'DUPLICATE',text:'Duplicate'},{statu